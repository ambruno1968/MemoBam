<Window x:Class="MemoBam.QuickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestione Note Pronte — Diario"
        Icon="Assets/memobam.ico"
        Width="600"
        Height="460"
        MinWidth="460"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚡ Tabella Note Pronte per il Diario"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,10"/>

        <!-- Add / Edit Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="QuickNoteInputTextBox"
                         Padding="9,7"
                         FontSize="13"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Background="White"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Nuova nota pronta (es. Listino cavi aggiornato)..."
                           Foreground="#94A3B8"
                           FontSize="12.5"
                           Margin="11,0,8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QuickNoteInputTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button x:Name="SaveQuickNoteButton"
                    Grid.Column="2"
                    Content="➕ Aggiungi"
                    Padding="12,7"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="SaveQuickNoteButton_Click"/>

            <Button x:Name="CancelEditQuickNoteButton"
                    Grid.Column="4"
                    Content="Annulla"
                    Padding="10,7"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    FontWeight="SemiBold"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="CancelEditQuickNoteButton_Click"/>
        </Grid>

        <!-- Separate Table (DataGrid) for Quick Notes -->
        <DataGrid x:Name="QuickNotesDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  RowBackground="White"
                  AlternatingRowBackground="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nota pronta"
                                    Binding="{Binding Text}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Azioni" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Button Content="↙️ Usa"
                                        Tag="{Binding}"
                                        Click="UseQuickNoteButton_Click"
                                        Padding="8,4"
                                        Margin="0,0,5,0"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Inserisci questa nota nel Diario"/>
                                <Button Content="✏️ Modifica"
                                        Tag="{Binding}"
                                        Click="EditQuickNoteButton_Click"
                                        Padding="8,4"
                                        Margin="0,0,5,0"
                                        Background="#E2E8F0"
                                        Foreground="#1E293B"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                                <Button Content="🗑️ Elimina"
                                        Tag="{Binding}"
                                        Click="DeleteQuickNoteButton_Click"
                                        Padding="8,4"
                                        Background="#FEE2E2"
                                        Foreground="#B91C1C"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Chiudi"
                    Width="96"
                    Height="32"
                    Background="#0F172A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="MemoBam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MemoBam — Archivio Lavori Eseguiti"
        Width="1120"
        Height="720"
        MinWidth="16"
        MinHeight="16"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        BorderBrush="#0F172A"
        BorderThickness="1">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="#E2E8F0"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F172A"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Collapsed Edge Strip (shown when Auto-Hide is active and collapsed) -->
        <Border x:Name="CollapsedStripBorder"
                Visibility="Collapsed"
                Background="#0F172A"
                BorderBrush="#2563EB"
                BorderThickness="2"
                Cursor="Hand"
                AllowDrop="True"
                MouseEnter="CollapsedStrip_MouseEnter"
                MouseLeftButtonUp="CollapsedStrip_MouseLeftButtonUp"
                ToolTip="Passa il mouse o trascina qui un file per aprire MemoBam">
            <Grid>
                <TextBlock x:Name="CollapsedStripLabel"
                           Text="◀ MemoBam"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Mini Drag & Drop Only Overlay (shown when "Sullo sfondo" is active and idle) -->
        <Border x:Name="MiniDropOverlay"
                Visibility="Collapsed"
                Background="#F8FAFC"
                BorderBrush="#2563EB"
                BorderThickness="2"
                CornerRadius="12"
                Padding="12"
                AllowDrop="True"
                DragEnter="DropZone_DragEnter"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop"
                MouseEnter="MiniDropOverlay_MouseEnter"
                MouseLeftButtonDown="MiniDropOverlay_MouseLeftButtonDown"
                ToolTip="Trascina qui un documento per archiviarlo, oppure passa il mouse per aprire MemoBam">
            <Grid>
                <Rectangle Stroke="#94A3B8"
                           StrokeThickness="1.5"
                           StrokeDashArray="4 3"
                           RadiusX="8"
                           RadiusY="8"
                           Margin="-4"
                           IsHitTestVisible="False"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📥"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="MemoBam — Trascina qui"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="Passa il mouse per aprire la finestra"
                               FontSize="11"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Full Application Window -->
        <Grid x:Name="RootContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Compact Header + Drag Bar -->
            <Border Grid.Row="0"
                    Background="#0F172A"
                    Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Title + Window Chrome Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MemoBam"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionTextBlock"
                                       Text="v1.0.0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#60A5FA"
                                       Margin="7,2,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  •  Archivio Lavori &amp; Diario"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2563EB" CornerRadius="11" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TotalCountBadge"
                                           Text="0 schede"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                            </Border>
                            <Button Content="—"
                                    Style="{StaticResource WindowChromeButtonStyle}"
                                    ToolTip="Riduci a icona"
                                    Click="MinimizeButton_Click"/>
                            <Button x:Name="MaximizeButton"
                                    Content="□"
                                    Style="{StaticResource WindowChromeButtonStyle}"
                                    ToolTip="Ingrandisci / Ripristina"
                                    Click="MaximizeButton_Click"/>
                            <Button Content="✕"
                                    Style="{StaticResource WindowChromeButtonStyle}"
                                    ToolTip="Chiudi"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Dock / Anchor / Folder Controls -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="DockNormalRadio"
                                     GroupName="DockMode"
                                     IsChecked="True"
                                     Style="{StaticResource DockButtonStyle}"
                                     Checked="DockMode_Changed"
                                     ToolTip="Finestra normale">
                            <TextBlock Text="Finestra" FontSize="11" Foreground="White"/>
                        </RadioButton>
                        <RadioButton x:Name="DockBottomRadio"
                                     GroupName="DockMode"
                                     Style="{StaticResource DockButtonStyle}"
                                     Checked="DockMode_Changed"
                                     ToolTip="Ancora la barra in basso sullo schermo">
                            <TextBlock Text="⬇ Basso" FontSize="11" Foreground="White"/>
                        </RadioButton>
                        <RadioButton x:Name="DockLeftRadio"
                                     GroupName="DockMode"
                                     Style="{StaticResource DockButtonStyle}"
                                     Checked="DockMode_Changed"
                                     ToolTip="Ancora come barra verticale a sinistra">
                            <TextBlock Text="⬅ Sx" FontSize="11" Foreground="White"/>
                        </RadioButton>
                        <RadioButton x:Name="DockRightRadio"
                                     GroupName="DockMode"
                                     Style="{StaticResource DockButtonStyle}"
                                     Checked="DockMode_Changed"
                                     ToolTip="Ancora come barra verticale a destra (a scomparsa)">
                            <TextBlock Text="➡ Dx" FontSize="11" Foreground="White"/>
                        </RadioButton>

                        <ToggleButton x:Name="AutoHideToggle"
                                      Checked="AutoHideToggle_Changed"
                                      Unchecked="AutoHideToggle_Changed"
                                      Cursor="Hand"
                                      ToolTip="Riduce automaticamente la barra a una striscia sul bordo quando non la usi"
                                      Margin="0,2,5,2">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="AutoHideBorder"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,5">
                                        <TextBlock x:Name="AutoHideText"
                                                   Text="👁️ Scomparsa"
                                                   FontSize="11"
                                                   Foreground="#CBD5E1"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="AutoHideBorder" Property="Background" Value="#7C3AED"/>
                                            <Setter TargetName="AutoHideBorder" Property="BorderBrush" Value="#A78BFA"/>
                                            <Setter TargetName="AutoHideText" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ToggleButton x:Name="DesktopModeToggle"
                                      Checked="DesktopModeToggle_Changed"
                                      Unchecked="DesktopModeToggle_Changed"
                                      Cursor="Hand"
                                      ToolTip="Resta ancorato sullo sfondo semitrasparente mostrando solo il riquadro Drag &amp; Drop"
                                      Margin="0,2,5,2">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,5">
                                        <TextBlock x:Name="ToggleText"
                                                   Text="📌 Sfondo"
                                                   FontSize="11"
                                                   Foreground="#CBD5E1"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="#0284C7"/>
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="ToggleText" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button x:Name="OpenArchiveFolderButton"
                                Click="OpenArchiveFolderButton_Click"
                                Cursor="Hand"
                                ToolTip="Apri la cartella principale MemoBam in Esplora File"
                                Background="#1E293B"
                                Foreground="#CBD5E1"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Padding="8,5"
                                Margin="0,2,0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Content}"
                                                   FontSize="11"
                                                   Foreground="#CBD5E1"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Content>📁 Cartella</Button.Content>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Main Content (adapts between 2-column and vertical sidebar) -->
            <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumnDef" Width="320"/>
                    <ColumnDefinition x:Name="SpacerColumnDef" Width="12"/>
                    <ColumnDefinition x:Name="RightColumnDef" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopRowDef" Height="*"/>
                    <RowDefinition x:Name="SpacerRowDef" Height="0"/>
                    <RowDefinition x:Name="BottomRowDef" Height="0"/>
                </Grid.RowDefinitions>

                <!-- Drop Zone & Quick Metadata Panel -->
                <Border x:Name="DropPanelBorder"
                        Grid.Column="0"
                        Grid.Row="0"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Archivia documento"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <StackPanel x:Name="OptionalMetadataPanel" Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Titolo personalizzato (opzionale)"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="CustomTitleTextBox"
                                     Padding="8,5"
                                     FontSize="12.5"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Margin="0,0,0,6"
                                     ToolTip="Se lasciato vuoto, usa il nome del file"/>

                            <TextBlock Text="Note lavoro (opzionale)"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="CustomNotesTextBox"
                                     Padding="8,5"
                                     FontSize="12.5"
                                     Height="38"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <!-- Drag & Drop Zone -->
                        <Border x:Name="DropZoneBorder"
                                Grid.Row="2"
                                AllowDrop="True"
                                DragEnter="DropZone_DragEnter"
                                DragOver="DropZone_DragOver"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop"
                                Background="#F8FAFC"
                                BorderBrush="#94A3B8"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10"
                                MinHeight="100">
                            <Grid>
                                <Rectangle Stroke="#94A3B8"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="4 3"
                                           RadiusX="8"
                                           RadiusY="8"
                                           Margin="-4"
                                           IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📥"
                                               FontSize="26"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,3"/>
                                    <TextBlock x:Name="DropZoneTitle"
                                               Text="Trascina qui i documenti"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#1E293B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="da Scrivania o Esplora File"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,2,0,8"/>
                                    <Button Content="Sfoglia file..."
                                            Click="BrowseFilesButton_Click"
                                            Padding="12,5"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            FontSize="11.5"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Options -->
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <CheckBox x:Name="MoveFilesCheckBox"
                                      Content="Sposta invece di copiare (rimuove dal Desktop)"
                                      FontSize="11.5"
                                      Foreground="#334155"
                                      VerticalContentAlignment="Center"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FixedPathTextBlock"
                                           Grid.Column="0"
                                           Text="Percorso: OneDrive\...\MemoBam"
                                           FontSize="10.5"
                                           Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Cambia..."
                                        Click="ChangeArchivePathButton_Click"
                                        Padding="8,3"
                                        Margin="6,0,0,0"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Background="#E2E8F0"
                                        Foreground="#1E293B"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Scegli una cartella principale diversa per Archivio e Diario"/>
                            </Grid>
                        </StackPanel>

                        <!-- Status message -->
                        <Border x:Name="StatusBanner"
                                Grid.Row="4"
                                Margin="0,8,0,0"
                                Padding="8,6"
                                CornerRadius="8"
                                Background="#ECFDF5"
                                BorderBrush="#A7F3D0"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusTextBlock"
                                       FontSize="11.5"
                                       Foreground="#065F46"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right / Bottom Panel: Tabs for Archive & Daily Diary -->
                <Grid x:Name="ArchivePanelGrid" Grid.Column="2" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Switcher -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="ArchiveTabRadio"
                                     GroupName="MainSection"
                                     IsChecked="True"
                                     Style="{StaticResource SectionTabStyle}"
                                     Checked="SectionTab_Changed">
                            <TextBlock Text="📁 Archivio Documenti" FontSize="12.5" FontWeight="SemiBold"/>
                        </RadioButton>
                        <RadioButton x:Name="DiaryTabRadio"
                                     GroupName="MainSection"
                                     Style="{StaticResource SectionTabStyle}"
                                     Checked="SectionTab_Changed">
                            <TextBlock x:Name="DiaryTabLabel" Text="📓 Diario Giornaliero (0)" FontSize="12.5" FontWeight="SemiBold"/>
                        </RadioButton>
                    </StackPanel>

                    <!-- TAB 1: Archivio Documenti -->
                    <Grid x:Name="ArchiveTabContent" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Border Grid.Row="0"
                                Background="White"
                                CornerRadius="10"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Padding="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="SearchTextBox"
                                             Padding="9,6"
                                             FontSize="12.5"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             TextChanged="SearchTextBox_TextChanged"/>
                                    <TextBlock Text="Cerca titolo, data (20/11/2026) o ora..."
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               Margin="11,0,8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <DatePicker x:Name="FilterDatePicker"
                                            Grid.Column="2"
                                            VerticalContentAlignment="Center"
                                            FontSize="12"
                                            SelectedDateChanged="FilterDatePicker_SelectedDateChanged"
                                            ToolTip="Filtra per data specifica"/>

                                <Button Grid.Column="4"
                                        Content="Pulisci"
                                        Click="ClearSearchButton_Click"
                                        Padding="10,6"
                                        Background="#E2E8F0"
                                        Foreground="#334155"
                                        FontWeight="SemiBold"
                                        FontSize="11.5"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Results Summary -->
                        <TextBlock x:Name="ResultsSummaryTextBlock"
                                   Grid.Row="1"
                                   Text="0 schede trovate"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="4,8,4,6"/>

                        <!-- Cards List -->
                        <ListBox x:Name="CardsListBox"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 MouseDoubleClick="CardsListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="10"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="8"
                                                    Background="#EFF6FF"
                                                    BorderBrush="#BFDBFE"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Top"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileTypeBadge}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="#1D4ED8"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,8,2">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1E293B">
                                                            <Run Text="📅 "/>
                                                            <Run Text="{Binding DateFormatted, Mode=OneWay}"/>
                                                            <Run Text="  🕒 "/>
                                                            <Run Text="{Binding TimeFormatted, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock Text="{Binding OriginalFileName}"
                                                               FontSize="11.5"
                                                               Foreground="#475569"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="180"/>

                                                    <TextBlock Text=" • "
                                                               FontSize="11.5"
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Text="{Binding FileSizeFormatted}"
                                                               FontSize="11.5"
                                                               Foreground="#475569"
                                                               VerticalAlignment="Center"/>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding Notes}"
                                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <WrapPanel Grid.Column="2"
                                                       Orientation="Horizontal"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0">
                                                <Button Content="Apri"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Background="#2563EB"
                                                        Foreground="White"
                                                        Tag="{Binding}"
                                                        Click="OpenItemButton_Click"/>
                                                <Button Content="Cartella"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Tag="{Binding}"
                                                        Click="RevealItemButton_Click"/>
                                                <Button Content="Modifica"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Tag="{Binding}"
                                                        Click="EditItemButton_Click"/>
                                                <Button Content="Elimina"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Background="#FEE2E2"
                                                        Foreground="#B91C1C"
                                                        Tag="{Binding}"
                                                        Click="DeleteItemButton_Click"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State -->
                        <TextBlock x:Name="EmptyStateTextBlock"
                                   Grid.Row="2"
                                   Text="Nessuna scheda trovata.&#x0a;Trascina un documento nella zona di archiviazione per creare la prima scheda."
                                   FontSize="13"
                                   Foreground="#64748B"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- TAB 2: Diario Giornaliero -->
                    <Grid x:Name="DiaryTabContent" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Diary Controls: Date + Search + Folder -->
                        <Border Grid.Row="0"
                                Background="White"
                                CornerRadius="10"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Padding="9"
                                Margin="0,0,0,8">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <DatePicker x:Name="DiaryDatePicker"
                                            Width="130"
                                            VerticalContentAlignment="Center"
                                            FontSize="12"
                                            SelectedDateChanged="DiaryDatePicker_SelectedDateChanged"
                                            Margin="0,2,6,2"
                                            ToolTip="Giorno del diario"/>
                                <Button Content="Oggi"
                                        Click="DiaryTodayButton_Click"
                                        Padding="10,5"
                                        Background="#EFF6FF"
                                        Foreground="#1D4ED8"
                                        FontWeight="SemiBold"
                                        FontSize="11.5"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,2,6,2"/>
                                <Button Content="Tutti i giorni"
                                        Click="DiaryAllDaysButton_Click"
                                        Padding="10,5"
                                        Background="#E2E8F0"
                                        Foreground="#334155"
                                        FontWeight="SemiBold"
                                        FontSize="11.5"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,2,8,2"/>

                                <TextBox x:Name="DiarySearchTextBox"
                                         Width="180"
                                         Padding="8,5"
                                         FontSize="12"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         TextChanged="DiarySearchTextBox_TextChanged"
                                         ToolTip="Cerca nel diario (testo, data o ora)"
                                         Margin="0,2,8,2"/>

                                <Button Content="📂 Cartella Diario"
                                        Click="OpenDiaryFolderButton_Click"
                                        Padding="10,5"
                                        Background="#0F172A"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        FontSize="11.5"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,2,0,2"/>
                            </WrapPanel>
                        </Border>

                        <!-- Quick Record Input -->
                        <Border Grid.Row="1"
                                Background="White"
                                CornerRadius="10"
                                BorderBrush="#93C5FD"
                                BorderThickness="1.5"
                                Padding="10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="DiaryInputTextBox"
                                             Padding="10,7"
                                             FontSize="13"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             AcceptsReturn="False"
                                             KeyDown="DiaryInputTextBox_KeyDown"/>
                                    <TextBlock Text="Cosa hai fatto? Scrivi l'attività e premi Invio..."
                                               Foreground="#94A3B8"
                                               FontSize="12.5"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DiaryInputTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="2"
                                        Content="✓ Registra"
                                        Click="AddDiaryEntryButton_Click"
                                        Padding="14,7"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        FontSize="12.5"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DiarySummaryTextBlock"
                                   Grid.Row="2"
                                   Text="0 attività registrate"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="4,2,4,6"/>

                        <!-- Diary Entries List -->
                        <ListBox x:Name="DiaryListBox"
                                 Grid.Row="3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="9"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#F1F5F9"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    VerticalAlignment="Top"
                                                    Margin="0,0,10,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1E293B">
                                                    <Run Text="📅 "/>
                                                    <Run Text="{Binding DateFormatted, Mode=OneWay}"/>
                                                    <Run Text="  🕒 "/>
                                                    <Run Text="{Binding TimeFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="13"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Content="Elimina"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Background="#FEE2E2"
                                                        Foreground="#B91C1C"
                                                        Tag="{Binding}"
                                                        Click="DeleteDiaryEntryButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="DiaryEmptyTextBlock"
                                   Grid.Row="3"
                                   Text="Nessuna attività registrata per questa selezione.&#x0a;Scrivi sopra cosa hai fatto: verrà salvato automaticamente con data e ora."
                                   FontSize="13"
                                   Foreground="#64748B"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="MemoBam.DiaryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dettaglio Nota Diario"
        Width="580"
        Height="470"
        MinWidth="420"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4">
                <TextBlock x:Name="TimestampTextBlock"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>
            </Border>
            <CheckBox x:Name="DoneCheckBox"
                      Content="Fatto"
                      FontSize="12.5"
                      FontWeight="SemiBold"
                      Foreground="#1E293B"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Formatting Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="B"
                    Command="EditingCommands.ToggleBold"
                    CommandTarget="{Binding ElementName=NoteRichTextBox}"
                    FontWeight="Bold"
                    Width="28"
                    Height="26"
                    Margin="0,0,4,0"
                    Background="#E2E8F0"
                    Foreground="#0F172A"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Grassetto (Ctrl+B)"/>
            <Button Content="I"
                    Command="EditingCommands.ToggleItalic"
                    CommandTarget="{Binding ElementName=NoteRichTextBox}"
                    FontStyle="Italic"
                    FontFamily="Georgia"
                    Width="28"
                    Height="26"
                    Margin="0,0,4,0"
                    Background="#E2E8F0"
                    Foreground="#0F172A"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Corsivo (Ctrl+I)"/>
            <Button Content="• Elenco"
                    Command="EditingCommands.ToggleBullets"
                    CommandTarget="{Binding ElementName=NoteRichTextBox}"
                    Padding="8,0"
                    Height="26"
                    Margin="0,0,4,0"
                    FontSize="11.5"
                    Background="#E2E8F0"
                    Foreground="#0F172A"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Elenco puntato"/>
            <Button Content="☑ Spunta"
                    Click="InsertCheckBoxButton_Click"
                    Padding="8,0"
                    Height="26"
                    FontSize="11.5"
                    Background="#E2E8F0"
                    Foreground="#0F172A"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Inserisci una casella di spunta secondaria"/>
        </StackPanel>

        <!-- Full Multi-line Rich Note -->
        <RichTextBox x:Name="NoteRichTextBox"
                     Grid.Row="2"
                     Padding="10,8"
                     FontSize="13.5"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     Background="White"
                     Margin="0,0,0,12">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Attachments (if any) -->
        <StackPanel x:Name="AttachmentsSection" Grid.Row="3" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock Text="Allegati collegati:"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       Margin="0,0,0,4"/>
            <ItemsControl x:Name="AttachmentsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayLabel}"
                                Tag="{Binding}"
                                Click="OpenAttachmentButton_Click"
                                Margin="0,0,6,4"
                                Padding="8,4"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Foreground="#1D4ED8"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Apri allegato"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Chiudi"
                    Width="96"
                    Height="34"
                    Margin="0,0,10,0"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
            <Button Content="💾 Salva"
                    Width="110"
                    Height="34"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
